@startuml
class HeatingController {
    +setTemperature(houseId, targetTemp)
}
class HeatingService {
    +validateDevice(deviceId)
    +applyTemperature(targetTemp)
    +saveState(state)
}
class ThermostatAdapter {
    +sendCommand(deviceId, command)
}
class HeatingRepository {
    +findDeviceByHouse(houseId)
    +updateState(deviceId, state)
}
class EventPublisher {
    +publish(topic, event)
}
class DeviceStatus {
    -deviceId: UUID
    -targetTemp: float
    -currentTemp: float
    -updatedAt: Timestamp
}
HeatingController --> HeatingService : uses
HeatingService --> ThermostatAdapter : uses
HeatingService --> HeatingRepository : uses
HeatingService --> EventPublisher : uses
HeatingRepository ..> DeviceStatus : persists
HeatingService ..> DeviceStatus : creates/reads
@enduml