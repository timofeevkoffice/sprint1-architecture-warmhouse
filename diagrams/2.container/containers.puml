@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(owner, "Владелец дома")

System_Boundary(ecosystem, "Экосистема Тёплый дом") {
    Container(web_ui, "Веб-интерфейс", "React", "Панель управления")
    Container(api_gateway, "API Gateway", "Kong", "Аутентификация, маршрутизация")
    
    Container(heating, "Сервис отопления", "Go", "Управление отоплением и термостатами")
    Container(lighting, "Сервис освещения", "Go", "Управление светом")
    Container(gate, "Сервис ворот", "Go", "Управление автоматическими воротами")
    Container(surveillance, "Сервис видеонаблюдения", "Go", "Видеопотоки, детекция движения")
    
    Container(device_registry, "Реестр устройств", "Go", "Регистрация и конфигурация")
    Container(telemetry, "Сервис телеметрии", "Go", "Сбор и хранение показателей")
    Container(automation, "Сервис автоматизации", "Go", "Выполнение сценариев если-то")
    Container(users, "Сервис пользователей", "Go", "Регистрация, аутентификация")
    Container(billing, "Сервис биллинга", "Go", "Управление подписками")
    
    Container(message_broker, "Брокер сообщений", "RabbitMQ", "Асинхронный обмен")
    
    ContainerDb(heating_db, "БД отопления", "PostgreSQL")
    ContainerDb(lighting_db, "БД освещения", "PostgreSQL")
    ContainerDb(gate_db, "БД ворот", "PostgreSQL")
    ContainerDb(surveillance_db, "БД видеонаблюдения", "PostgreSQL")
    ContainerDb(device_db, "БД устройств", "PostgreSQL")
    ContainerDb(telemetry_db, "БД телеметрии", "TimescaleDB")
    ContainerDb(users_db, "БД пользователей", "PostgreSQL")
    ContainerDb(billing_db, "БД биллинга", "PostgreSQL")
}

System_Ext(partner_devices, "Устройства партнёров", "Zigbee, MQTT, HTTP")
System_Ext(payment_gateway, "Платёжный шлюз", "Stripe")

Rel(owner, web_ui, "Использует", "HTTPS")
Rel(web_ui, api_gateway, "Вызовы API", "HTTPS")
Rel(api_gateway, heating, "REST")
Rel(api_gateway, lighting, "REST")
Rel(api_gateway, gate, "REST")
Rel(api_gateway, surveillance, "REST, WebSocket")
Rel(api_gateway, device_registry, "REST")
Rel(api_gateway, telemetry, "REST")
Rel(api_gateway, automation, "REST")
Rel(api_gateway, users, "REST")
Rel(api_gateway, billing, "REST")

Rel(heating, heating_db, "SQL")
Rel(lighting, lighting_db, "SQL")
Rel(gate, gate_db, "SQL")
Rel(surveillance, surveillance_db, "SQL")
Rel(device_registry, device_db, "SQL")
Rel(telemetry, telemetry_db, "SQL")
Rel(users, users_db, "SQL")
Rel(billing, billing_db, "SQL")

Rel(heating, message_broker, "Публикует события", "AMQP")
Rel(lighting, message_broker, "Публикует события", "AMQP")
Rel(gate, message_broker, "Публикует события", "AMQP")
Rel(surveillance, message_broker, "Публикует события", "AMQP")
Rel(device_registry, message_broker, "Публикует события", "AMQP")
Rel(telemetry, message_broker, "Потребляет и публикует", "AMQP")
Rel(automation, message_broker, "Подписывается и отправляет команды", "AMQP")

Rel(heating, partner_devices, "MQTT/HTTP")
Rel(lighting, partner_devices, "MQTT/HTTP")
Rel(gate, partner_devices, "MQTT/HTTP")
Rel(surveillance, partner_devices, "HTTP/RTP")
Rel(device_registry, partner_devices, "MQTT/HTTP")
Rel(telemetry, partner_devices, "MQTT")

Rel(billing, payment_gateway, "HTTPS")

@enduml