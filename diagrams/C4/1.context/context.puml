@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Person — пользователь
Person(owner, "Владелец дома", "Управляет умными устройствами, просматривает телеметрию")
Person(support, "Специалист поддержки", "Помогает с подключением и настройкой")

' System — наша система (экосистема)
System(ecosystem, "Экосистема Тёплый дом", "SaaS-платформа для управления умным домом")

' System_Ext — внешняя система
System_Ext(devices, "Устройства партнёров", "Датчики, реле, камеры (Zigbee, MQTT, HTTP)")
System_Ext(billing, "Платёжная система", "Обработка подписок и платежей")

' Rel — отношения
Rel(owner, ecosystem, "Использует через веб/мобильное приложение", "HTTPS")
Rel(support, ecosystem, "Настраивает и поддерживает", "HTTPS")
Rel(ecosystem, devices, "Управляет и получает телеметрию", "MQTT/HTTP")
Rel(ecosystem, billing, "Выставляет счета", "API")

@enduml