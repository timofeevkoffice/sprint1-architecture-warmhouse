@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(billing, "Сервис биллинга", "Go")

Boundary(billing_internals, "Внутренности Сервиса биллинга") {
    Component(api, "REST API", "Gin", "Получение тарифов, подписки")
    Component(subscription_manager, "Управление подписками", "Go", "Создание/отмена подписки")
    Component(payment_provider_adapter, "Адаптер платежей", "HTTP", "Связь с платёжным шлюзом")
    Component(invoice_generator, "Генератор счетов", "Go", "Формирование счетов")
    Component(repo, "Репозиторий", "GORM", "Доступ к БД биллинга")
}

ContainerDb(billing_db, "БД биллинга", "PostgreSQL")
System_Ext(payment_gateway, "Платёжный шлюз", "Stripe / Яндекс.Касса")
Container(api_gateway, "API Gateway")

Rel(api_gateway, api, "REST")
Rel(api, subscription_manager, "Uses")
Rel(subscription_manager, repo, "Uses")
Rel(subscription_manager, invoice_generator, "Uses")
Rel(invoice_generator, payment_provider_adapter, "Вызывает")
Rel(payment_provider_adapter, payment_gateway, "HTTPS")
Rel(repo, billing_db, "SQL")

@enduml